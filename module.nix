{ config, lib, pkgs, ... }:

let
  cfg = config.programs.claude-code.notifySound;
  claudeCode = config.programs.claude-code;

  # Where home-manager drops files from programs.claude-code.hooks.
  hookScript = "${claudeCode.configDir}/hooks/${cfg.hookName}";

  # The payloads are JSON on stdin, matched as plain text to keep the hook
  # free of jq. Quoting the token avoids matching it inside a longer name.
  mkPattern = type: "*'\"${type}\"'*";
  notificationPatterns = lib.concatStringsSep " | " (map mkPattern cfg.notificationTypes);

  # Assembled line by line rather than from nested Nix strings, so the hook
  # that lands in ~/.claude/hooks stays readable.
  caseArms = lib.concatStringsSep "\n" (
    lib.optionals cfg.onPermissionRequest [
      "  # PermissionRequest runs before the permission dialog is drawn, so this"
      "  # is the low-latency path for \"Claude needs a response\"."
      "  ${mkPattern "PermissionRequest"}) want=yes ;;"
      ""
    ]
    ++ lib.optionals (cfg.notificationTypes != [ ]) [
      "  # Notification trails the dialog by ~5-6s (Claude Code debounces it),"
      "  # so permission_prompt is left out of notificationTypes by default --"
      "  # PermissionRequest already covers that dialog and matching both would"
      "  # double-play. The remaining types have no earlier hook to fire from."
      "  ${notificationPatterns}) want=yes ;;"
      ""
    ]
    ++ [ "  *) want=no ;;" ]
  );

  logLine = verb: fields:
    if cfg.logFile == null
    then ":"
    else "printf '%s ${verb} ${fields}\\n' ${
      if verb == "PLAY"
      then ''"$ts" "$rc" "$XDG_RUNTIME_DIR" "''${err:-none}" "$payload"''
      else ''"$ts" "$payload"''
    } >> ${cfg.logFile}";

  # Deliberately avoids external commands (bash builtins for the timestamp and
  # UID) and resolves the player by store path, so it still works when the hook
  # environment has no PATH.
  notifyScript = ''
    #!/usr/bin/env bash
    # Generated by claude-notify. Edits here are overwritten on the next
    # home-manager switch -- change the Nix options instead.

    : "''${XDG_RUNTIME_DIR:=/run/user/$UID}"
    export XDG_RUNTIME_DIR

    IFS= read -r -d ''' payload || true
    printf -v ts '%(%Y-%m-%dT%H:%M:%S)T' -1

    case "$payload" in
    ${caseArms}
    esac

    if [ "$want" = yes ]; then
      err=$(${cfg.player} ${cfg.sound} 2>&1)
      rc=$?
      ${logLine "PLAY" "rc=%s xdg=%s err=%s payload=%s"}
    else
      ${logLine "SKIP" "payload=%s"}
    fi
    exit 0
  '';

  # async so playback never delays the dialog it is announcing. No matcher, so
  # every tool is covered.
  hookEntry = [
    {
      hooks = [
        {
          type = "command";
          # Invoked through bash rather than directly: older home-manager
          # releases write hook files without the +x bit.
          command = "bash ${hookScript}";
          async = true;
          timeout = cfg.timeout;
        }
      ];
    }
  ];

in
{
  options.programs.claude-code.notifySound = {
    enable = lib.mkEnableOption "a notification sound for when Claude Code needs your input";

    sound = lib.mkOption {
      type = lib.types.path;
      default = ./assets/claude_notify.wav;
      defaultText = lib.literalExpression "./assets/claude_notify.wav";
      description = ''
        Audio file to play. The bundled clip peaks at -32 dB;
        {file}`assets/claude_notify_master.wav` is the untouched -1.2 dB trim,
        kept so the level can be re-dialled:

        ```
        ffmpeg -i assets/claude_notify_master.wav -af volume=-30.8dB \
          -c:a pcm_s16le assets/claude_notify.wav
        ```
      '';
    };

    player = lib.mkOption {
      type = lib.types.str;
      default = "${pkgs.pipewire}/bin/pw-play";
      defaultText = lib.literalExpression ''"''${pkgs.pipewire}/bin/pw-play"'';
      example = lib.literalExpression ''"''${pkgs.pulseaudio}/bin/paplay"'';
      description = ''
        Command that plays {option}`sound`, which is appended as its only
        argument. Give an absolute path: the hook may run without a PATH.
      '';
    };

    onPermissionRequest = lib.mkOption {
      type = lib.types.bool;
      default = true;
      description = ''
        Fire from the {var}`PermissionRequest` hook, which runs before the
        permission dialog is drawn. This is the fast path -- the equivalent
        {var}`Notification` event lands several seconds later.
      '';
    };

    notificationTypes = lib.mkOption {
      type = lib.types.listOf lib.types.str;
      default = [
        "idle_prompt"
        "agent_needs_input"
        "elicitation_dialog"
        "elicitation_url_dialog"
      ];
      example = [ "idle_prompt" "permission_prompt" ];
      description = ''
        {var}`Notification` types that play the sound. Set to `[ ]` to skip the
        {var}`Notification` hook entirely.

        {var}`permission_prompt` is omitted by default on purpose: with
        {option}`onPermissionRequest` enabled it would play the sound twice for
        the same dialog.
      '';
    };

    timeout = lib.mkOption {
      type = lib.types.ints.positive;
      default = 15;
      description = "Seconds Claude Code waits for the hook before giving up on it.";
    };

    hookName = lib.mkOption {
      type = lib.types.str;
      default = "notify-sound.sh";
      description = ''
        File name for the hook under the {file}`hooks/` subdirectory of
        {option}`programs.claude-code.configDir`.
      '';
    };

    logFile = lib.mkOption {
      type = lib.types.nullOr lib.types.str;
      default = "${claudeCode.configDir}/notify-sound.log";
      defaultText = lib.literalExpression ''"''${config.programs.claude-code.configDir}/notify-sound.log"'';
      description = ''
        Append one line per event (played or skipped, with the player's exit
        code and the raw payload) here. Set to `null` to log nothing.

        The file grows without bound; it is meant for working out why a sound
        did or did not play, not for permanent use.
      '';
    };
  };

  config = lib.mkIf cfg.enable {
    assertions = [
      {
        assertion = cfg.onPermissionRequest || cfg.notificationTypes != [ ];
        message = ''
          programs.claude-code.notifySound is enabled but nothing can trigger
          it: enable onPermissionRequest, or list at least one entry in
          notificationTypes.
        '';
      }
    ];

    programs.claude-code = {
      hooks.${cfg.hookName} = notifyScript;

      settings.hooks =
        lib.optionalAttrs cfg.onPermissionRequest { PermissionRequest = hookEntry; }
        // lib.optionalAttrs (cfg.notificationTypes != [ ]) { Notification = hookEntry; };
    };
  };
}
